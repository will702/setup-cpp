#!/usr/bin/env bash
# cpc — competitive-programming compile wrapper
#
# Usage:
#   cpc sol.cpp            debug build (sanitizers + LOCAL + _GLIBCXX_DEBUG)
#   cpc -r sol.cpp         release/submit build (clean, fast, no overhead)
#   cpc --submit sol.cpp   same as -r
#   cpc -h                 show help
#
# Config (lowest → highest priority):
#   ~/.config/cp/cp.conf   global defaults (written by install.sh)
#   .cpcrc                 per-project overrides (optional, in problem dir)
#
# .cpcrc example:
#   CP_STD="c++17"                    # override standard for this project
#   EXTRA_FLAGS="-DONLINE_JUDGE"      # append extra flags to every build
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

# ── load global config ────────────────────────────────────────────────────
CP_CONF="${HOME}/.config/cp/cp.conf"
if [[ ! -f "$CP_CONF" ]]; then
    echo "cpc: config not found at $CP_CONF — run install.sh first" >&2
    exit 1
fi
# shellcheck source=/dev/null
source "$CP_CONF"
# CP_GXX, CP_STD, CP_DIR are now set

# ── load per-project overrides (.cpcrc in current or parent dirs) ─────────
# Walk up directory tree looking for .cpcrc (stops at $HOME or /)
_search="${PWD}"
while [[ "$_search" != "/" && "$_search" != "$HOME" ]]; do
    if [[ -f "${_search}/.cpcrc" ]]; then
        # shellcheck source=/dev/null
        source "${_search}/.cpcrc"
        echo "[cpc] using local config: ${_search}/.cpcrc"
        break
    fi
    _search="$(dirname "$_search")"
done
unset _search

# EXTRA_FLAGS defaults to empty if not set in .cpcrc
EXTRA_FLAGS="${EXTRA_FLAGS:-}"

# ── argument parsing ──────────────────────────────────────────────────────
RELEASE=0
SHOW_HELP=0
SOURCE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--submit|--release) RELEASE=1; shift ;;
        -h|--help)             SHOW_HELP=1; shift ;;
        -*)
            echo "cpc: unknown flag '$1' (try -h)" >&2
            exit 1
            ;;
        *)
            if [[ -n "$SOURCE" ]]; then
                echo "cpc: only one source file at a time" >&2
                exit 1
            fi
            SOURCE="$1"
            shift
            ;;
    esac
done

if [[ $SHOW_HELP -eq 1 ]]; then
    cat <<'EOF'
cpc — competitive-programming compile wrapper (Homebrew GCC)

Usage:
  cpc sol.cpp              debug build
  cpc -r sol.cpp           release / submit build
  cpc --submit sol.cpp     same as -r
  cpc -h                   this help

Debug flags  : -O2 -Wall -Wextra -Wshadow -Wconversion
               -fsanitize=address,undefined -fno-sanitize-recover=all
               -D_GLIBCXX_DEBUG -DLOCAL -g
               (DLOCAL activates dbg() in debug.h)

Release flags: -O2 -Wall -Wextra
               (no sanitizers, no DLOCAL, no _GLIBCXX_DEBUG)

Output binary: same name as source minus .cpp  (sol.cpp → ./sol)

Per-project config (.cpcrc in problem directory):
  CP_STD="c++17"              override C++ standard
  EXTRA_FLAGS="-DSOME_MACRO"  append flags to every build
EOF
    exit 0
fi

if [[ -z "$SOURCE" ]]; then
    echo "cpc: no source file given (try cpc -h)" >&2
    exit 1
fi

if [[ ! -f "$SOURCE" ]]; then
    echo "cpc: file not found: $SOURCE" >&2
    exit 1
fi

# ── derive output name ────────────────────────────────────────────────────
BASE="${SOURCE%.cpp}"
BASE="$(basename "$BASE")"
OUT="./${BASE}"

# ── build flags ───────────────────────────────────────────────────────────
COMMON_FLAGS=(
    "-std=${CP_STD}"
    "-Wall" "-Wextra" "-Wshadow" "-Wconversion"
    "-I${CP_DIR}/include"
)
# append per-project extra flags (may be empty)
[[ -n "$EXTRA_FLAGS" ]] && COMMON_FLAGS+=($EXTRA_FLAGS)

if [[ $RELEASE -eq 0 ]]; then
    FLAGS=(
        "${COMMON_FLAGS[@]}"
        "-O2"
        "-I${CP_DIR}/pch-debug"
        "-D_GLIBCXX_DEBUG"
        "-DLOCAL"
        "-g"
        "-fsanitize=address,undefined"
        "-fno-sanitize-recover=all"
    )
    LABEL="debug"
else
    FLAGS=(
        "${COMMON_FLAGS[@]}"
        "-O2"
        "-I${CP_DIR}/pch-release"
    )
    LABEL="release"
fi

# ── compile ───────────────────────────────────────────────────────────────
echo "[cpc] ${LABEL}: ${CP_GXX} ${SOURCE} → ${OUT}"
"${CP_GXX}" "${FLAGS[@]}" -o "${OUT}" "${SOURCE}"
echo "[cpc] OK"
